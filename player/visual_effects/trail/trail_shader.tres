code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D tex_frg_2 : source_color;
uniform float Speed = 0.10000000149012;
uniform float InitalAlpga = 0.46000000834465;
uniform float FloatParameter = 6.0;



void fragment() {
// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, UV);


// FloatOp:23
	float n_in23p1 = 15.00000;
	float n_out23p0 = n_out2p0.x * n_in23p1;


// Input:8
	float n_out8p0 = TIME;


// FloatParameter:9
	float n_out9p0 = Speed;


// FloatOp:10
	float n_out10p0 = n_out8p0 / n_out9p0;


// FloatOp:22
	float n_out22p0 = n_out23p0 + n_out10p0;


// FloatFunc:7
	float n_out7p0 = sin(n_out22p0);


	float n_out12p0;
// Remap:12
	float n_in12p1 = -1.00000;
	float n_in12p2 = 1.00000;
	float n_in12p3 = -0.10000;
	float n_in12p4 = 0.10000;
	{
		float __input_range = n_in12p2 - n_in12p1;
		float __output_range = n_in12p4 - n_in12p3;
		n_out12p0 = n_in12p3 + __output_range * ((n_out7p0 - n_in12p1) / __input_range);
	}


// FloatOp:13
	float n_in13p0 = 0.00000;
	float n_out13p0 = n_in13p0 - n_out12p0;


// FloatParameter:14
	float n_out14p0 = InitalAlpga;


// FloatOp:15
	float n_out15p0 = n_out2p0.x * n_out14p0;


// FloatOp:16
	float n_out16p0 = n_out13p0 - n_out15p0;


// FloatParameter:18
	float n_out18p0 = FloatParameter;


// FloatOp:19
	float n_out19p0 = n_out16p0 * n_out18p0;


// FloatFunc:20
	float n_out20p0 = floor(n_out19p0);


// FloatOp:21
	float n_out21p0 = n_out20p0 / n_out18p0;


// Output:0
	ALPHA = n_out21p0;


}
"
